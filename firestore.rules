rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School Roster (Student credentials, DOBs, Exam numbers): strictly server-only
    match /roster/{userId} {
      allow read, write: if false;
    }

    // Faculty Roster (Staff credentials, roles): strictly server-only
    match /faculty_roster/{userId} {
      allow read, write: if false;
    }

    // Exam Sessions and timer locks: strictly server-only
    match /exam_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Authoritative answer keys: strictly server-only
    match /exams/{examId}/private_keys/{document=**} {
      allow read, write: if false;
    }

    // Submissions: client creation, updates, and direct reads strictly forbidden.
    // Role-scoped reading and authoritative grading is enforced exclusively via /api/exams/submissions.
    match /submissions/{subId} {
      allow read, write: if false;
    }

    // Exam definitions: published examinations are strictly read-only for authenticated users; client writes forbidden
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // School configuration: read-only for authenticated users; client writes forbidden
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



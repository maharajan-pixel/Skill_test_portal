rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Exam metadata and questions
    match /exams/{examId} {
      allow read: if true;
      allow write: if true;
    }
    // Student submissions and scores
    match /submissions/{subId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    // School Roster (Students, Teachers, Admin)
    match /roster/{userId} {
      allow read: if true;
      allow write: if true;
    }
    // Global school configurations
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
